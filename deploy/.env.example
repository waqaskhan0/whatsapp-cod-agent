# Copy to .env on the server and fill in. Never commit .env.

# --- domains -----------------------------------------------------------------
# Both must already point at this server's IP (an A record each).
N8N_DOMAIN=n8n.yourclient.com
DASH_DOMAIN=dash.yourclient.com

# --- dashboard login ---------------------------------------------------------
DASH_USER=seller
# Generate with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
DASH_PASSWORD_HASH=$2a$14$replace_this_with_a_real_hash

# --- WhatsApp ----------------------------------------------------------------
WA_PHONE_NUMBER_ID=
# Use a SYSTEM USER token, not the 24-hour one from the dashboard.
# Business settings -> Users -> System users -> Generate new token
WA_TOKEN=

# --- internal ----------------------------------------------------------------
# Shared secret between n8n and the classifier. Any long random string.
SERVICE_TOKEN=change-me-to-something-random

# --- model -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=

# --- tuning ------------------------------------------------------------------
AUTO_THRESHOLD=0.80
# The seller's real two-way courier cost. Ask them; do not guess.
RTO_COST_PKR=300
TZ=Asia/Karachi
