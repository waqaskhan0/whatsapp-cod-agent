# Copy to .env.local and fill in. .env.local is gitignored - never commit it.

# From Meta: WhatsApp -> Step 1. Try it out -> the number under "From"
WA_PHONE_NUMBER_ID=1349779751542892

# From the same page: click "Generate token". Expires every 24 hours while
# testing, so expect to paste a fresh one here most days.
WA_TOKEN=your_EAA_token_here

# Any random string. Must match whatever the classifier runs with.
SERVICE_TOKEN=dev-secret-123
